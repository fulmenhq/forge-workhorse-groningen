# Groningen Environment Variables




# Copy this file to .env and customize for your environment




# The .env file is gitignored and will not be committed









# Application Configuration




GRONINGEN_PORT=8080




GRONINGEN_HOST=localhost









# Logging Configuration




GRONINGEN_LOG_LEVEL=info




# Options: trace, debug, info, warn, error









# Metrics and Health




GRONINGEN_METRICS_ENABLED=true




GRONINGEN_METRICS_PORT=9090




GRONINGEN_METRICS_PATH=/metrics




GRONINGEN_HEALTH_ENABLED=true









# Configuration File Path




# If not set, uses XDG config dir: ~/.config/groningen/config.yaml




# GRONINGEN_CONFIG_PATH=./config/groningen.yaml









# Server Options




GRONINGEN_READ_TIMEOUT=30s




GRONINGEN_WRITE_TIMEOUT=30s




GRONINGEN_IDLE_TIMEOUT=120s




GRONINGEN_SHUTDOWN_TIMEOUT=10s









# Worker Configuration




GRONINGEN_WORKERS=4









# Debug Options




# GRONINGEN_DEBUG=false




# GRONINGEN_PPROF_ENABLED=false









# Control Plane (Advanced - Optional)
#
# Operational control endpoints on a dedicated server (loopback by default).
# Endpoints (default): http://127.0.0.1:9091/control/*
#
# WARNING: Only bind to non-loopback interfaces with strong authentication
# and restricted network access.
#
# Canonical (nested):
# GRONINGEN_CONTROL_PLANE_ENABLED=true
# GRONINGEN_CONTROL_PLANE_HOST=127.0.0.1
# GRONINGEN_CONTROL_PLANE_PORT=9091
# GRONINGEN_CONTROL_PLANE_BASE_PATH=/control
# GRONINGEN_CONTROL_PLANE_BEARER_TOKEN=your-secret-token-here
#
# Aliases (backward compatible):
# GRONINGEN_CONTROLPLANE_ENABLED=true
# GRONINGEN_CONTROLPLANE_HOST=127.0.0.1
# GRONINGEN_CONTROLPLANE_PORT=9091
# GRONINGEN_CONTROLPLANE_BASEPATH=/control
# GRONINGEN_CONTROLPLANE_BEARERTOKEN=your-secret-token-here









# Database Configuration (if needed)




# GRONINGEN_DB_DSN=postgres://user:pass@localhost:5432/dbname




# GRONINGEN_DB_MAX_CONNECTIONS=25




# GRONINGEN_DB_MAX_IDLE=5









# External Services (examples)




# GRONINGEN_API_KEY=your-api-key-here




# GRONINGEN_EXTERNAL_URL=https://api.example.com
