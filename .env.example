# Groningen Environment Variables
#
# Copy this file to .env and customize for your environment.
# The .env file is gitignored and will not be committed.
#
# Env vars support both canonical (nested) and alias (short) forms.
# If both are set with different values, the alias takes precedence
# and a warning is logged. Run `groningen doctor` to detect conflicts.
#
# Sensitive values (TOKEN, SECRET, PASSWORD, KEY) are masked in
# diagnostic output (`groningen envinfo`, `groningen doctor`).

# ─── Application / Server ───────────────────────────────────────────
#
# Canonical                      Alias
# GRONINGEN_SERVER_HOST          GRONINGEN_HOST
# GRONINGEN_SERVER_PORT          GRONINGEN_PORT

GRONINGEN_PORT=8080
GRONINGEN_HOST=localhost

# ─── Logging ────────────────────────────────────────────────────────
#
# Canonical                      Alias
# GRONINGEN_LOGGING_LEVEL        GRONINGEN_LOG_LEVEL
# GRONINGEN_LOGGING_PROFILE      GRONINGEN_LOG_PROFILE

GRONINGEN_LOG_LEVEL=info
# Options: trace, debug, info, warn, error
# GRONINGEN_LOG_PROFILE=STRUCTURED
# Options: SIMPLE, STRUCTURED, ENTERPRISE

# ─── Metrics and Health ─────────────────────────────────────────────
#
# No aliases (canonical only)

GRONINGEN_METRICS_ENABLED=true
GRONINGEN_METRICS_PORT=9090
GRONINGEN_HEALTH_ENABLED=true

# ─── Server Timeouts ────────────────────────────────────────────────
#
# Canonical                          Alias
# GRONINGEN_SERVER_READ_TIMEOUT      GRONINGEN_READ_TIMEOUT
# GRONINGEN_SERVER_WRITE_TIMEOUT     GRONINGEN_WRITE_TIMEOUT
# GRONINGEN_SERVER_IDLE_TIMEOUT      GRONINGEN_IDLE_TIMEOUT
# GRONINGEN_SERVER_SHUTDOWN_TIMEOUT  GRONINGEN_SHUTDOWN_TIMEOUT

GRONINGEN_READ_TIMEOUT=30s
GRONINGEN_WRITE_TIMEOUT=30s
GRONINGEN_IDLE_TIMEOUT=120s
GRONINGEN_SHUTDOWN_TIMEOUT=10s

# ─── Worker Configuration ───────────────────────────────────────────

GRONINGEN_WORKERS=4

# ─── Debug Options ──────────────────────────────────────────────────
#
# Canonical                      Alias
# GRONINGEN_DEBUG_ENABLED        GRONINGEN_DEBUG
# GRONINGEN_DEBUG_PPROF_ENABLED  GRONINGEN_PPROF_ENABLED

# GRONINGEN_DEBUG=false
# GRONINGEN_PPROF_ENABLED=false

# ─── Control Plane (Operational Endpoints) ──────────────────────────
#
# Dedicated loopback-bound server for operational control.
# WARNING: Only bind to non-loopback interfaces with strong
# authentication and restricted network access.
#
# Canonical                              Alias
# GRONINGEN_CONTROL_PLANE_ENABLED        GRONINGEN_CONTROLPLANE_ENABLED
# GRONINGEN_CONTROL_PLANE_HOST           GRONINGEN_CONTROLPLANE_HOST
# GRONINGEN_CONTROL_PLANE_PORT           GRONINGEN_CONTROLPLANE_PORT
# GRONINGEN_CONTROL_PLANE_BASE_PATH      GRONINGEN_CONTROLPLANE_BASEPATH
# GRONINGEN_CONTROL_PLANE_BEARER_TOKEN   GRONINGEN_CONTROLPLANE_BEARERTOKEN

# GRONINGEN_CONTROL_PLANE_ENABLED=true
# GRONINGEN_CONTROL_PLANE_HOST=127.0.0.1
# GRONINGEN_CONTROL_PLANE_PORT=9091
# GRONINGEN_CONTROL_PLANE_BASE_PATH=/control
# GRONINGEN_CONTROL_PLANE_BEARER_TOKEN=your-secret-token-here

# ─── Data Plane Auth (Optional Starter Framework) ───────────────────
#
# Optional auth for the primary API surface. Disabled by default.
# CDRL users should replace with their preferred auth strategy.
#
# Canonical                                  Alias
# GRONINGEN_DATA_PLANE_AUTH_ENABLED          GRONINGEN_DATAPLANEAUTH_ENABLED
# GRONINGEN_DATA_PLANE_AUTH_MODE             GRONINGEN_DATAPLANEAUTH_MODE
# GRONINGEN_DATA_PLANE_AUTH_BEARER_TOKEN     GRONINGEN_DATAPLANEAUTH_BEARERTOKEN
# GRONINGEN_DATA_PLANE_AUTH_BASIC_USERNAME   GRONINGEN_DATAPLANEAUTH_BASIC_USERNAME
# GRONINGEN_DATA_PLANE_AUTH_BASIC_PASSWORD   GRONINGEN_DATAPLANEAUTH_BASIC_PASSWORD

# GRONINGEN_DATA_PLANE_AUTH_ENABLED=false
# GRONINGEN_DATA_PLANE_AUTH_MODE=disabled
# Options: disabled, bearerToken, basicAuth
# GRONINGEN_DATA_PLANE_AUTH_BEARER_TOKEN=your-api-token-here
# GRONINGEN_DATA_PLANE_AUTH_BASIC_USERNAME=admin
# GRONINGEN_DATA_PLANE_AUTH_BASIC_PASSWORD=changeme

# ─── Configuration File Path ────────────────────────────────────────
#
# If not set, uses XDG config dir: ~/.config/groningen/config.yaml
# GRONINGEN_CONFIG_PATH=./config/groningen.yaml

# ─── Database Configuration (if needed) ─────────────────────────────
#
# GRONINGEN_DB_DSN=postgres://user:pass@localhost:5432/dbname
# GRONINGEN_DB_MAX_CONNECTIONS=25
# GRONINGEN_DB_MAX_IDLE=5

# ─── External Services (examples) ───────────────────────────────────
#
# GRONINGEN_API_KEY=your-api-key-here
# GRONINGEN_EXTERNAL_URL=https://api.example.com
